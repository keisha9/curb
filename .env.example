# Copy to .env (gitignored). Never commit real values.
# Backend secrets live in Convex env vars (npx convex env set NAME value), not here.

# Written by `npx convex dev`; used by the Vite web app.
VITE_CONVEX_URL=
# Local ops dashboard only: must equal OPS_KEY on Convex. Never set it in the hosted build.
VITE_OPS_KEY=
# Where the dashboard's QR code points (the hosted trips site).
VITE_TRIPS_URL=https://keisha9.github.io/curb/trips/

# ---- Convex environment variables (set in Convex, listed here for reference) ----
# ANTHROPIC_API_KEY=
# BRAIN_MODE=llm                     # llm (default when ANTHROPIC_API_KEY is set) or scripted
# LLM_RIDE_TOKEN_BUDGET=200000       # per-ride token cap across all Claude calls
# CARTESIA_API_KEY=                 # unset = outbound calls are stubbed (DB only)
# VOICE_WEBHOOK_SECRET=             # shared secret for /voice/tools (bearer) and /voice/events
# TWILIO_ACCOUNT_SID=                # unset = SMS is stubbed (DB only); off for now
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# OPS_KEY=                          # required by every ops dashboard query and demo control
# PORTAL_BASE_URL=                   # e.g. https://your-app.example; SMS links go to {PORTAL_BASE_URL}/trips?t=...
# PORTAL_TOKEN_TTL_DAYS=14
# ALLOWED_OUTBOUND_NUMBERS=          # comma-separated E.164; the only numbers ever dialed or texted
# DEMO_MARIA_PHONE=                  # seed phone numbers (numbers you control); default to fictional 555-01xx
# DEMO_JAMES_PHONE=
# DEMO_ROSA_PHONE=
# DEMO_BROKER_PHONE=
